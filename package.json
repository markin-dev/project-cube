    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.14.6",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
